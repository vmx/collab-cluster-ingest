# Copy to deploy/.env and adjust. deploy/.env is gitignored -- keep
# per-deployment paths and any secrets out of the repo. See Config in
# src/collab_cluster_torrentizer/config.py for defaults and full docs.

JETSTREAM_URL=wss://jetstream1.us-east.bsky.network
OUTPUT_DIR=./output
STATE_DB_PATH=./state.sqlite3
ALLOWED_PUBLISHER_DIDS=
TARGET_STAC_COLLECTION=sentinel-2-l2a
WORKER_CONCURRENCY=4
QUEUE_MAXSIZE=100
HTTP_TIMEOUT_SECONDS=30.0
